# Copy to .env.staging (git-ignored). Used by the load test; the web config values are not secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
# Path to the STAGING service-account key (keep it outside the repo). Never use a production key.
GOOGLE_APPLICATION_CREDENTIALS=
# A debug token registered under App Check > your web app > Manage debug tokens (staging only)
APPCHECK_DEBUG_TOKEN=
