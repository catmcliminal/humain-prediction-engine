# Copy to .env.local (git-ignored) for local development against a real Firebase project.
VITE_GAME_ID=ai-2027
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
VITE_APPCHECK_SITE_KEY=
# Set to 1 to run against the Firebase Emulator Suite (no real project needed)
VITE_USE_EMULATOR=
# Set to 1 with an App Check debug token registered in the console (load tests, local dev)
VITE_APPCHECK_DEBUG=
